// Documentação do Prisma Schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  conta     Conta
  documento String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Conta {
  CPF
  CNPJ
}

model Planta {
  id            Int          @id @default(autoincrement())
  nome          String
  especie       String
  /// Preço em centavos: 8990 = R$ 89,90
  preco         Int
  /// Quantidade de vasos disponíveis (0 = esgotada)
  estoque       Int
  luminosidade  Luminosidade
  petFriendly   Boolean
  /// De quantos em quantos dias a planta deve ser regada
  regaACadaDias Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum Luminosidade {
  SOMBRA
  MEIA_SOMBRA
  SOL_PLENO
}
